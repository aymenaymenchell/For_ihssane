<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>عقارات الجزائر | DZ Real Estate</title>
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@400;600;700;800&family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/qrcodejs/1.0.0/qrcode.min.js"></script>
<style>
:root{--primary:#1B3A4B;--primary-light:#2C5468;--gold:#C65D3B;--gold-light:#D97B57;--sand:#E8DCC4;--olive:#5C6B47;--bg:#FAF7F2;--bg2:#FFFFFF;--bg3:#F3EEE4;--text:#1E2A2E;--text2:#4E5D5F;--text3:#7A8688;--border:#E4DDD0;--shadow:0 4px 20px rgba(27,58,75,0.08);--shadow-hover:0 10px 34px rgba(27,58,75,0.16);--radius:14px;--radius-sm:9px;--success:#3F7D5C;--danger:#B84A3C;--warning:#C08A2E;--info:#3A6B8A;--font-ar:'Cairo',sans-serif;--font-fr:'Fraunces','Inter',sans-serif;--font-ui:'Inter',sans-serif;--transition:all 0.3s ease;}
[data-theme="dark"]{--primary:#2C5468;--gold:#D97B57;--gold-light:#E8946E;--sand:#3A3428;--olive:#6E8058;--bg:#131C1F;--bg2:#1B282C;--bg3:#16211F;--text:#EDE8DD;--text2:#B8AF9E;--text3:#8A8577;--border:#2E3A38;--shadow:0 4px 20px rgba(0,0,0,0.4);--shadow-hover:0 10px 34px rgba(0,0,0,0.55);}
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{font-family:var(--font-ar);background:var(--bg);color:var(--text);transition:var(--transition);line-height:1.6;overflow-x:hidden;}
body.ltr{font-family:var(--font-ui);direction:ltr}
a{text-decoration:none;color:inherit}
img{max-width:100%;display:block}
button{cursor:pointer;border:none;outline:none;font-family:inherit}
input,select,textarea{font-family:inherit;outline:none}
ul{list-style:none}
.hidden{display:none!important}
.container{max-width:1280px;margin:0 auto;padding:0 20px}
::-webkit-scrollbar{width:8px}
::-webkit-scrollbar-track{background:var(--bg3)}
::-webkit-scrollbar-thumb{background:var(--primary);border-radius:4px}
/* NAVBAR */
#navbar{position:sticky;top:0;z-index:1000;background:var(--bg2);border-bottom:1px solid var(--border);box-shadow:var(--shadow);transition:var(--transition);}
.nav-inner{display:flex;align-items:center;justify-content:space-between;padding:12px 20px;max-width:1280px;margin:0 auto;gap:16px;}
.nav-logo{display:flex;align-items:center;gap:10px;font-size:1.3rem;font-weight:800;color:var(--primary);cursor:pointer;white-space:nowrap;}
.nav-logo span{color:var(--gold)}
.nav-logo i{font-size:1.6rem;color:var(--gold)}
.nav-links{display:flex;align-items:center;gap:4px;flex-wrap:wrap;}
.nav-links a{padding:8px 14px;border-radius:var(--radius-sm);font-size:0.9rem;font-weight:500;color:var(--text2);transition:var(--transition);white-space:nowrap;}
.nav-links a:hover,.nav-links a.active{background:var(--primary);color:#fff;}
.nav-links a.post-btn{background:var(--gold);color:#fff;font-weight:700;}
.nav-links a.post-btn:hover{background:var(--gold-light)}
.nav-actions{display:flex;align-items:center;gap:8px}
.nav-actions button{width:38px;height:38px;border-radius:50%;background:var(--bg3);border:1px solid var(--border);color:var(--text2);font-size:1rem;display:flex;align-items:center;justify-content:center;transition:var(--transition);}
.nav-actions button:hover{background:var(--primary);color:#fff;border-color:var(--primary)}
#lang-btn{background:var(--primary)!important;color:#fff!important;border-color:var(--primary)!important;font-size:0.75rem!important;font-weight:700;width:42px!important;border-radius:8px!important;}
.hamburger{display:none;flex-direction:column;gap:5px;padding:8px;background:transparent;border:none}
.hamburger span{display:block;width:24px;height:2px;background:var(--text);border-radius:2px;transition:var(--transition)}
@media(max-width:900px){.nav-links{display:none;position:fixed;top:65px;left:0;right:0;background:var(--bg2);border-bottom:1px solid var(--border);flex-direction:column;padding:16px;gap:4px;z-index:999;box-shadow:var(--shadow);}.nav-links.open{display:flex}.nav-links a{width:100%;text-align:center}.hamburger{display:flex}}
/* PAGES */
.page{display:none}.page.active{display:block}
/* HERO */
#hero{position:relative;min-height:540px;display:flex;align-items:center;justify-content:center;overflow:hidden;}
#hero::before{content:'';position:absolute;inset:0;background:linear-gradient(160deg,rgba(27,58,75,0.94) 0%,rgba(27,58,75,0.82) 55%,rgba(198,93,59,0.35) 100%);z-index:1;}
#hero::after{content:'';position:absolute;inset:0;z-index:1;opacity:0.15;background-image:
  linear-gradient(45deg, transparent 48%, rgba(232,220,196,0.4) 49%, rgba(232,220,196,0.4) 51%, transparent 52%),
  linear-gradient(-45deg, transparent 48%, rgba(232,220,196,0.4) 49%, rgba(232,220,196,0.4) 51%, transparent 52%);
  background-size:44px 44px;}
#hero-bg{position:absolute;inset:0;background:url('https://images.unsplash.com/photo-1560448204-e02f11c3d0e2?w=1600&q=80') center/cover no-repeat;z-index:0;}
.hero-content{position:relative;z-index:2;text-align:center;color:#fff;padding:40px 20px;max-width:860px;width:100%;}
.hero-content h1{font-size:2.9rem;font-weight:800;letter-spacing:-0.01em;text-shadow:0 2px 14px rgba(0,0,0,0.35);margin-bottom:10px;}
body.ltr .hero-content h1{font-family:var(--font-fr);font-weight:600;font-optical-sizing:auto;}
.hero-content p{font-size:1.1rem;opacity:0.9;margin-bottom:30px}
/* SEARCH BOX */
#search-box{background:var(--bg2);border-radius:var(--radius);box-shadow:0 8px 40px rgba(0,0,0,0.25);padding:24px;max-width:800px;margin:0 auto;}
.search-row{display:flex;gap:10px;align-items:center}
.search-input-wrap{position:relative;flex:1}
#main-search{width:100%;height:52px;padding:0 16px;border:2px solid var(--border);border-radius:var(--radius-sm);font-size:1rem;background:var(--bg);color:var(--text);transition:var(--transition);}
#main-search:focus{border-color:var(--primary)}
#autocomplete-list{position:absolute;top:100%;left:0;right:0;z-index:100;background:var(--bg2);border:1px solid var(--border);border-radius:var(--radius-sm);box-shadow:var(--shadow);max-height:250px;overflow-y:auto;}
#autocomplete-list div{padding:10px 16px;cursor:pointer;transition:var(--transition);font-size:0.9rem;color:var(--text2);}
#autocomplete-list div:hover{background:var(--bg3);color:var(--primary)}
.btn-search{height:52px;padding:0 28px;background:var(--primary);color:#fff;border-radius:var(--radius-sm);font-size:1rem;font-weight:700;transition:var(--transition);white-space:nowrap;}
.btn-search:hover{background:var(--primary-light);transform:translateY(-1px)}
.btn-filter{height:52px;padding:0 18px;background:var(--bg3);color:var(--text2);border:1px solid var(--border);border-radius:var(--radius-sm);font-size:0.9rem;transition:var(--transition);}
.btn-filter:hover{background:var(--primary);color:#fff;border-color:var(--primary)}
/* FILTERS */
#advanced-filters{margin-top:16px;padding-top:16px;border-top:1px solid var(--border);display:grid;grid-template-columns:repeat(auto-fill,minmax(180px,1fr));gap:12px;}
.filter-group label{display:block;font-size:0.82rem;font-weight:600;color:var(--text2);margin-bottom:4px;}
.filter-group select,.filter-group input{width:100%;height:40px;padding:0 10px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);font-size:0.9rem;transition:var(--transition);}
.filter-group select:focus,.filter-group input:focus{border-color:var(--primary)}
.type-btns{display:flex;gap:6px}
.type-btn{flex:1;height:38px;border:2px solid var(--border);border-radius:var(--radius-sm);font-size:0.85rem;font-weight:600;color:var(--text2);background:var(--bg);transition:var(--transition);}
.type-btn.active,.type-btn:hover{background:var(--primary);color:#fff;border-color:var(--primary);}
.filter-actions{grid-column:1/-1;display:flex;gap:10px;justify-content:flex-end;}
.btn-reset{padding:8px 20px;background:var(--bg3);border:1px solid var(--border);border-radius:var(--radius-sm);color:var(--text2);font-size:0.9rem;transition:var(--transition);}
.btn-reset:hover{background:var(--danger);color:#fff;border-color:var(--danger)}
/* STATS BAR */
#stats-bar{background:var(--primary);color:#fff;padding:16px 0;}
.stats-inner{display:flex;justify-content:center;gap:40px;flex-wrap:wrap;}
.stat-item{text-align:center}
.stat-item .num{font-size:1.8rem;font-weight:800;color:var(--gold);}
.stat-item .lbl{font-size:0.85rem;opacity:0.85}
/* SECTION */
.section{padding:50px 0}
.section-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:28px;flex-wrap:wrap;gap:12px;}
.section-title{font-size:1.5rem;font-weight:800;color:var(--primary);position:relative;padding-right:20px;}
body.ltr .section-title{padding-right:0;padding-left:20px}
.section-title::before{content:'';position:absolute;right:0;top:50%;transform:translateY(-50%) rotate(45deg);width:10px;height:10px;background:var(--gold);border-radius:2px;}
body.ltr .section-title::before{right:auto;left:0}
/* SORT BAR */
#sort-bar{display:flex;align-items:center;gap:12px;flex-wrap:wrap;margin-bottom:20px;}
#sort-bar select{padding:8px 14px;border:1px solid var(--border);border-radius:var(--radius-sm);background:var(--bg2);color:var(--text);font-size:0.9rem;}
#results-count{font-size:0.9rem;color:var(--text3);background:var(--bg3);padding:6px 14px;border-radius:var(--radius-sm);}
/* CARDS */
#listings-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:24px;}
.listing-card{background:var(--bg2);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);overflow:hidden;transition:var(--transition);cursor:pointer;position:relative;}
.listing-card:hover{transform:translateY(-4px) scale(1.01);box-shadow:var(--shadow-hover);}
.listing-card.vip{border:1.5px solid var(--gold);box-shadow:0 4px 22px rgba(198,93,59,0.2);}
.card-img{position:relative;height:200px;overflow:hidden;background:var(--bg3);}
.card-img img{width:100%;height:100%;object-fit:cover;transition:var(--transition);}
.listing-card:hover .card-img img{transform:scale(1.05)}
.card-badge{position:absolute;top:10px;right:10px;padding:4px 10px;border-radius:20px;font-size:0.75rem;font-weight:700;}
body.ltr .card-badge{right:auto;left:10px}
.badge-rent{background:#38A169;color:#fff}
.badge-sale{background:#3182CE;color:#fff}
.badge-vip{position:absolute;top:10px;left:10px;background:var(--gold);color:#fff;padding:4px 12px 4px 10px;border-radius:3px;font-size:0.72rem;font-weight:700;letter-spacing:0.03em;box-shadow:0 2px 8px rgba(198,93,59,0.35);}
body.ltr .badge-vip{left:auto;right:10px}
.card-fav{position:absolute;bottom:10px;right:10px;width:34px;height:34px;border-radius:50%;background:rgba(255,255,255,0.9);display:flex;align-items:center;justify-content:center;color:var(--text3);font-size:1rem;transition:var(--transition);border:none;cursor:pointer;box-shadow:0 2px 8px rgba(0,0,0,0.15);}
body.ltr .card-fav{right:auto;left:10px}
.card-fav.active,.card-fav:hover{color:var(--danger)}
.card-body{padding:16px}
.card-type{font-size:0.78rem;font-weight:600;color:var(--text3);text-transform:uppercase;letter-spacing:0.5px;margin-bottom:4px;}
.card-price{font-size:1.35rem;font-weight:800;color:var(--primary);margin-bottom:6px;}
body.ltr .card-price{font-family:var(--font-fr);font-weight:600;}
.card-price span{font-size:0.8rem;font-weight:500;color:var(--text3)}
.card-loc{display:flex;align-items:center;gap:6px;font-size:0.88rem;color:var(--text2);margin-bottom:10px;}
.card-loc i{color:var(--gold);font-size:0.9rem}
.card-meta{display:flex;gap:12px;flex-wrap:wrap;padding-top:10px;border-top:1px solid var(--border);}
.meta-item{display:flex;align-items:center;gap:5px;font-size:0.82rem;color:var(--text3);}
.meta-item i{color:var(--primary);font-size:0.85rem}
/* PAGINATION */
#pagination{display:flex;justify-content:center;gap:8px;margin-top:32px;flex-wrap:wrap;}
.page-btn{width:40px;height:40px;border-radius:var(--radius-sm);background:var(--bg2);border:1px solid var(--border);color:var(--text2);font-size:0.9rem;font-weight:600;transition:var(--transition);}
.page-btn:hover,.page-btn.active{background:var(--primary);color:#fff;border-color:var(--primary);}
/* NO RESULTS */
#no-results{text-align:center;padding:60px 20px;background:var(--bg2);border-radius:var(--radius);border:1px solid var(--border);}
#no-results i{font-size:3rem;color:var(--text3);margin-bottom:16px}
/* LOADING */
#loading-overlay{position:fixed;inset:0;z-index:9999;background:rgba(0,0,0,0.5);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;}
.spinner{width:56px;height:56px;border:5px solid rgba(255,255,255,0.2);border-top-color:var(--gold);border-radius:50%;animation:spin 0.8s linear infinite;}
@keyframes spin{to{transform:rotate(360deg)}}
/* FORM */
.form-page{max-width:800px;margin:0 auto;padding:40px 20px}
.form-card{background:var(--bg2);border-radius:var(--radius);box-shadow:var(--shadow);border:1px solid var(--border);padding:32px;}
.form-title{font-size:1.6rem;font-weight:800;color:var(--primary);margin-bottom:8px;}
.form-subtitle{font-size:0.9rem;color:var(--text3);margin-bottom:28px}
.steps-nav{display:flex;gap:0;margin-bottom:32px;border-radius:var(--radius-sm);overflow:hidden;border:1px solid var(--border);}
.step-tab{flex:1;padding:12px 8px;text-align:center;font-size:0.82rem;font-weight:600;background:var(--bg3);color:var(--text3);border-right:1px solid var(--border);transition:var(--transition);cursor:pointer;}
body.ltr .step-tab{border-right:none;border-left:1px solid var(--border)}
.step-tab:last-child{border:none}
.step-tab.active{background:var(--primary);color:#fff}
.step-tab.done{background:var(--success);color:#fff}
.step-content{display:none}
.step-content.active{display:block}
.form-group{margin-bottom:20px}
.form-group label{display:block;font-size:0.88rem;font-weight:600;color:var(--text2);margin-bottom:6px;}
.form-group label span.req{color:var(--danger)}
.form-group input,.form-group select,.form-group textarea{width:100%;padding:10px 14px;border:1.5px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);color:var(--text);font-size:0.95rem;transition:var(--transition);}
.form-group input:focus,.form-group select:focus,.form-group textarea:focus{border-color:var(--primary);box-shadow:0 0 0 3px rgba(26,54,93,0.1)}
.form-group textarea{resize:vertical;min-height:100px}
.form-row{display:grid;grid-template-columns:1fr 1fr;gap:16px}
@media(max-width:600px){.form-row{grid-template-columns:1fr}}
.input-hint{font-size:0.78rem;color:var(--text3);margin-top:4px}
.char-count{font-size:0.78rem;color:var(--text3);text-align:left;margin-top:2px}
/* TYPE GRID */
.type-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(120px,1fr));gap:10px;}
.type-card{padding:14px 8px;border:2px solid var(--border);border-radius:var(--radius-sm);text-align:center;cursor:pointer;transition:var(--transition);background:var(--bg);}
.type-card:hover{border-color:var(--primary);background:var(--bg3)}
.type-card.active{border-color:var(--primary);background:var(--primary);color:#fff;}
.type-card i{font-size:1.4rem;margin-bottom:6px;display:block}
.type-card span{font-size:0.8rem;font-weight:600}
/* PRICE SUGGESTION */
#price-suggestion{background:rgba(198,93,59,0.1);border:1px solid var(--gold);border-radius:var(--radius-sm);padding:10px 14px;font-size:0.85rem;color:var(--text2);margin-top:8px;}
#price-suggestion i{color:var(--gold)}
/* IMAGE PREVIEW */
#image-preview{display:grid;grid-template-columns:repeat(auto-fill,minmax(100px,1fr));gap:8px;margin-top:10px;}
.img-thumb{position:relative;height:80px;border-radius:var(--radius-sm);overflow:hidden;background:var(--bg3);}
.img-thumb img{width:100%;height:100%;object-fit:cover}
.img-thumb button{position:absolute;top:4px;right:4px;width:20px;height:20px;border-radius:50%;background:var(--danger);color:#fff;font-size:0.7rem;display:flex;align-items:center;justify-content:center;}
/* STEP NAV */
.step-nav-btns{display:flex;justify-content:space-between;align-items:center;margin-top:28px;padding-top:20px;border-top:1px solid var(--border);}
.btn-prev,.btn-next,.btn-submit{padding:12px 28px;border-radius:var(--radius-sm);font-size:0.95rem;font-weight:700;transition:var(--transition);}
.btn-prev{background:var(--bg3);color:var(--text2);border:1px solid var(--border);}
.btn-prev:hover{background:var(--primary);color:#fff;border-color:var(--primary)}
.btn-next{background:var(--primary);color:#fff}
.btn-next:hover{background:var(--primary-light);transform:translateY(-1px)}
/* PRICING */
#pricing-info{background:var(--bg3);border-radius:var(--radius-sm);padding:20px;margin-bottom:20px;}
.pricing-row{display:flex;align-items:center;justify-content:space-between;padding:10px 0;border-bottom:1px solid var(--border);}
.pricing-row:last-child{border:none}
.pricing-row .price-label{font-size:0.9rem;color:var(--text2)}
.pricing-row .price-value{font-size:1rem;font-weight:700;color:var(--primary);}
.vip-toggle{display:flex;align-items:center;gap:10px;padding:14px;background:rgba(198,93,59,0.1);border:1px solid var(--gold);border-radius:var(--radius-sm);cursor:pointer;margin-bottom:16px;}
.vip-toggle input{width:18px;height:18px;accent-color:var(--gold)}
.vip-toggle label{cursor:pointer;flex:1}
.vip-toggle .vip-price{font-size:1.1rem;font-weight:800;color:var(--gold);}
.pay-methods{display:flex;gap:12px;flex-wrap:wrap;margin-top:14px}
.pay-method-btn{flex:1;min-width:130px;padding:16px 12px;border:2px solid var(--border);border-radius:var(--radius-sm);background:var(--bg);text-align:center;cursor:pointer;transition:var(--transition);}
.pay-method-btn:hover{border-color:var(--primary);transform:translateY(-2px)}
.pay-method-btn i{font-size:1.8rem;color:var(--primary);margin-bottom:6px;display:block}
.pay-method-btn span{font-size:0.85rem;font-weight:700;color:var(--text)}
/* MODAL */
.modal-overlay{position:fixed;inset:0;z-index:2000;background:rgba(0,0,0,0.6);backdrop-filter:blur(4px);display:flex;align-items:center;justify-content:center;padding:20px;}
.modal-box{background:var(--bg2);border-radius:var(--radius);box-shadow:0 20px 60px rgba(0,0,0,0.3);padding:32px;max-width:520px;width:100%;position:relative;max-height:90vh;overflow-y:auto;}
.modal-box h2{font-size:1.4rem;font-weight:800;color:var(--primary);margin-bottom:6px;}
.modal-box p{font-size:0.9rem;color:var(--text2);margin-bottom:20px}
.modal-close{position:absolute;top:14px;right:14px;width:32px;height:32px;border-radius:50%;background:var(--bg3);color:var(--text3);display:flex;align-items:center;justify-content:center;font-size:1rem;transition:var(--transition);}
body.ltr .modal-close{right:auto;left:14px}
.modal-close:hover{background:var(--danger);color:#fff}
.pay-success{text-align:center;padding:20px}
.pay-success i{font-size:3.5rem;color:var(--success);margin-bottom:12px;display:block}
.pay-success h3{font-size:1.3rem;font-weight:700;color:var(--success);margin-bottom:8px}
.ref-code{background:var(--bg3);padding:10px 16px;border-radius:var(--radius-sm);font-size:1.1rem;font-weight:700;color:var(--primary);letter-spacing:2px;margin:10px 0;border:1px dashed var(--primary);display:inline-block;}
/* PAGE HEADER */
.page-header{background:linear-gradient(150deg,var(--primary) 0%,var(--primary-light) 65%,#3D6A50 130%);color:#fff;padding:52px 20px 42px;text-align:center;}
.page-header h1{font-size:2rem;font-weight:800;margin-bottom:8px}
.page-header p{font-size:1rem;opacity:0.85}
/* STATS CARDS */
.stats-cards{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:32px;}
.stat-card{background:var(--bg2);border-radius:var(--radius);padding:20px;text-align:center;box-shadow:var(--shadow);border:1px solid var(--border);}
.stat-card i{font-size:1.8rem;color:var(--gold);margin-bottom:8px}
.stat-card .val{font-size:1.6rem
